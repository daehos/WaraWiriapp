PORT=3001
# Path ke file service account JSON (relatif terhadap folder Backend/)
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json

# Email notifikasi approve/reject (opsional).
# Contoh Gmail: aktifkan 2-Step Verification, buat App Password 16 huruf.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alamat@gmail.com
SMTP_PASS=app-password-16-huruf
SMTP_FROM=WaraWiri Village <alamat@gmail.com>

# Notifikasi H-1 ke pemandu (PBI-5) — `npm run notify`
# Pengelola desa: menerima tembusan setiap email pemandu + peringatan bila rombongan belum punya pemandu.
MANAGER_EMAIL=pengelola@desa.example
# Jam (WIB) jendela notifikasi H-1 dibuka. Default 07
NOTIFY_HOUR_WIB=7
# 'h-1' (default, sesuai kartu PBI-5) atau 'segera' (kirim begitu admin Approve — untuk simulasi)
NOTIFY_MODE=h-1

# Hanya untuk `npm run local` (emulator): kirim email SUNGGUHAN lewat SMTP di atas ke alamat pemandu
# (mis. Mailinator). Default: email hanya ditulis ke Backend/outbox/local/. Salinan outbox tetap dibuat.
# SEND_REAL_EMAIL=true
