rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Tanggal hari ini (UTC) sebagai string YYYY-MM-DD — perbandingan
    // leksikografis ISO sama dengan kronologis, jadi tidak perlu parse datetime.
    function isoTodayUTC() {
      return string(request.time.year()) + '-' + pad2(request.time.month()) + '-' + pad2(request.time.day());
    }

    // Reservasi baru hanya boleh CREATE dengan bentuk data yang divalidasi.
    // Tidak ada yang boleh baca / ubah / hapus lewat client — backend (admin SDK)
    // tetap bisa membaca karena melewati rules.
    function validReservation(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'status', 'nama', 'kontak', 'email', 'tanggal', 'pax', 'waktu', 'jenisWisata', 'createdAt'])
        && d.id is string
        && d.id == id
        && d.id.matches('^WWR-[0-9]{8}-[0-9]{6}-[A-Z0-9]{4}$')
        && d.status == 'menunggu-konfirmasi'
        && isStr(d.nama, 2, 100)
        && isStr(d.kontak, 5, 100)
        && (d.kontak.matches('^(\\+62|62|0)8[1-9][0-9]{6,11}$')
            || d.kontak.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'))
        && ((d.email is string && isStr(d.email, 5, 100)
              && d.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'))
            || d.email == null)
        && d.tanggal is string
        && d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.tanggal >= isoTodayUTC()
        && d.pax is int && d.pax >= 1 && d.pax <= 1000
        && (!('waktu' in d) || isStr(d.waktu, 1, 30))
        && ((d.jenisWisata is string && d.jenisWisata.size() <= 100) || d.jenisWisata == null)
        && d.createdAt is string && d.createdAt.size() <= 40;
    }

    // Field tiket hanya ditulis admin: kode QR, waktu terbit, dan counter scan.
    function validTicketFields(d) {
      return (!('ticketCode' in d) || (d.ticketCode is string && d.ticketCode.matches('^[a-f0-9]{32}$')))
        && (!('manualCode' in d) || (d.manualCode is string && d.manualCode.matches('^[0-9]{6}$')))
        && (!('ticketIssuedAt' in d) || isStr(d.ticketIssuedAt, 1, 40))
        && (!('lastScanAt' in d) || isStr(d.lastScanAt, 1, 40))
        && (!('inside' in d) || (d.inside is int && d.inside >= 0 && d.inside <= d.pax))
        && (!('entries' in d) || (d.entries is int && d.entries >= 0))
        && (!('exits' in d) || (d.exits is int && d.exits >= 0));
    }

    // Field penugasan pemandu & status notifikasinya. Ditulis oleh dashboard admin
    // (mode online, lewat EmailJS) atau Backend (Admin SDK, melewati rules).
    function validGuideFields(d) {
      return (!('guideId' in d) || (d.guideId is string && d.guideId.matches('^[a-z0-9-]{1,60}$')))
        && (!('guideName' in d) || isStr(d.guideName, 1, 100))
        && (!('guideAssignedAt' in d) || isStr(d.guideAssignedAt, 1, 40))
        && (!('guideNotifiedAt' in d) || isStr(d.guideNotifiedAt, 1, 40))
        && (!('managerAlertAt' in d) || isStr(d.managerAlertAt, 1, 40))
        && (!('guideNotifyStatus' in d) || d.guideNotifyStatus in ['terkirim', 'gagal', 'tanpa-pemandu'])
        && (!('guideNotifyAttempts' in d) || (d.guideNotifyAttempts is int && d.guideNotifyAttempts >= 0 && d.guideNotifyAttempts <= 100))
        && (!('guideNotifyError' in d) || d.guideNotifyError == null || (d.guideNotifyError is string && d.guideNotifyError.size() <= 400));
    }

    // Admin = akun Firebase Auth dengan custom claim `admin: true`
    // (dipasang lewat `npm run make-admin -- email@…` di folder Backend).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ---- Kuota harian ----
    // quotas/{YYYY-MM-DD}: { tanggal, limit, used, lastReservationId }
    // Publik boleh baca (hanya angka) dan hanya boleh MENAIKKAN `used` sebesar
    // pax reservasi baru yang dibuat di request yang sama. Admin bebas set limit.
    function usedBefore(tanggal) {
      let path = /databases/$(database)/documents/quotas/$(tanggal);
      return exists(path) ? get(path).data.get('used', 0) : 0;
    }

    function limitBefore(tanggal) {
      let path = /databases/$(database)/documents/quotas/$(tanggal);
      return exists(path) ? get(path).data.get('limit', 100) : 100;
    }

    function quotaClaimed(id, d) {
      let after = getAfter(/databases/$(database)/documents/quotas/$(d.tanggal)).data;
      return after.used == usedBefore(d.tanggal) + d.pax
        && after.lastReservationId == id
        && after.used <= after.limit
        && after.tanggal == d.tanggal;
    }

    function validPublicQuota(tanggal) {
      let d = request.resource.data;
      let r = /databases/$(database)/documents/reservations/$(d.lastReservationId);
      return d.keys().hasOnly(['tanggal', 'limit', 'used', 'lastReservationId'])
        && d.tanggal == tanggal
        && d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.limit == limitBefore(tanggal)
        && d.limit is int
        && d.used is int
        && d.used == usedBefore(tanggal) + getAfter(r).data.pax
        && d.used <= d.limit
        && !exists(r)
        && getAfter(r).data.tanggal == tanggal
        && getAfter(r).data.status == 'menunggu-konfirmasi';
    }

    function validAdminQuota(tanggal) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tanggal', 'limit', 'used', 'lastReservationId'])
        && d.tanggal == tanggal
        && d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.limit is int
        && d.limit >= 1
        && d.limit <= 10000
        && (!('used' in d) || (d.used is int && d.used >= 0))
        && (!('lastReservationId' in d) || d.lastReservationId is string);
    }

    match /reservations/{reservationId} {
      allow create: if validReservation(reservationId)
        && quotaClaimed(reservationId, request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'ticketCode', 'manualCode', 'ticketIssuedAt', 'inside', 'entries', 'exits', 'lastScanAt',
          'guideId', 'guideName', 'guideAssignedAt', 'guideNotifiedAt', 'guideNotifyStatus',
          'guideNotifyAttempts', 'guideNotifyError', 'managerAlertAt'])
        && request.resource.data.status in ['dikonfirmasi', 'ditolak']
        && validTicketFields(request.resource.data)
        && validGuideFields(request.resource.data);
      allow delete: if false;
    }

    // Peta kode manual 6 digit -> reservasi. Hanya admin (scanner) yang baca/tulis.
    match /manualCodes/{code} {
      allow read: if isAdmin() && code.matches('^[0-9]{6}$');
      allow create: if isAdmin()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['reservationId', 'tanggal'])
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.matches('^WWR-[0-9]{8}-[0-9]{6}-[A-Z0-9]{4}$')
        && request.resource.data.tanggal is string
        && request.resource.data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update, delete: if isAdmin();
    }

    // Data pemandu (diinput manual / `npm run seed-guides`). Hanya admin yang
    // boleh membaca; penulisan lewat Admin SDK di Backend, tidak lewat client.
    // (Dashboard online membaca daftar pemandu dari Backend/data/guides.json
    // yang ikut ter-bundle, bukan dari koleksi ini.)
    match /guides/{guideId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /quotas/{tanggal} {
      allow read: if true;
      allow create, update: if (isAdmin() && validAdminQuota(tanggal))
        || (!isAdmin() && validPublicQuota(tanggal));
    }
  }
}
