rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Tanggal hari ini (UTC) sebagai string YYYY-MM-DD — perbandingan
    // leksikografis ISO sama dengan kronologis, jadi tidak perlu parse datetime.
    function isoTodayUTC() {
      return string(request.time.year) + '-' + pad2(request.time.month) + '-' + pad2(request.time.day);
    }

    // Reservasi baru hanya boleh CREATE dengan bentuk data yang divalidasi.
    // Tidak ada yang boleh baca / ubah / hapus lewat client — backend (admin SDK)
    // tetap bisa membaca karena melewati rules.
    function validReservation(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'status', 'nama', 'kontak', 'tanggal', 'pax', 'jenisWisata', 'createdAt'])
        && d.id is string
        && d.id == id
        && d.id.matches('^WWR-[0-9]{8}-[0-9]{6}-[A-Z0-9]{4}$')
        && d.status == 'menunggu-konfirmasi'
        && isStr(d.nama, 2, 100)
        && isStr(d.kontak, 5, 100)
        && (d.kontak.matches('^(\\+62|62|0)8[1-9][0-9]{6,11}$')
            || d.kontak.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'))
        && d.tanggal is string
        && d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.tanggal >= isoTodayUTC()
        && d.pax is int && d.pax >= 1 && d.pax <= 1000
        && ((d.jenisWisata is string && d.jenisWisata.size() <= 100) || d.jenisWisata == null)
        && d.createdAt is string && d.createdAt.size() <= 40;
    }

    match /reservations/{reservationId} {
      allow create: if validReservation(reservationId);
      allow read, update, delete: if false;
    }
  }
}
